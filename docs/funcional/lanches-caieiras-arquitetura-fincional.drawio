        </mxCell>
        <mxCell id="h3Dm0BbtpE6keSCLR1On-27" value="SEQUÊNCIA&lt;div&gt;&lt;ol&gt;&lt;li&gt;Aplicação recebe solicitção de cancelamento do pagamento via integração.&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(153, 153, 153), rgb(106, 106, 106));&quot;&gt;Caso de uso valida regra de cancelamento&lt;br&gt;&lt;/span&gt;2.1 DataProxy atualiza informações do pagamento no banco de Dados&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(153, 153, 153), rgb(106, 106, 106));&quot;&gt;Caso de uso envia cancelamento ou estorno do pagamento&lt;br&gt;&lt;/span&gt;3.1&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(153, 153, 153), rgb(106, 106, 106));&quot;&gt;DataProxy&amp;nbsp;&lt;/span&gt;cancelamento ou estorno do pagamento para MercadoPago&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(153, 153, 153), rgb(106, 106, 106));&quot;&gt;Enviada notificação do novo status do pagamento.&lt;br&gt;&lt;/span&gt;4.1 DataProxy envia notificação de cancelamento ou estorno do pagamento.&lt;/li&gt;&lt;/ol&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(153, 153, 153), rgb(106, 106, 106));&quot;&gt;* Se o pagamento estiver com status Paid é realizado estorno.&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(153, 153, 153), rgb(106, 106, 106));&quot;&gt;Se estiver com status Charged realiza cancelamento da cobrança.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#999999;strokeColor=#999999;verticalAlign=top;fillColor=default;fontStyle=0;align=left;spacingLeft=13;" vertex="1" parent="h3Dm0BbtpE6keSCLR1On-1">
          <mxGeometry x="160" y="430" width="520" height="180" as="geometry" />
        </mxCell>
        <mxCell id="h3Dm0BbtpE6keSCLR1On-28" value="LEGENDA" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#999999;strokeColor=#999999;verticalAlign=top;fillColor=default;fontStyle=0;align=left;spacingLeft=13;" vertex="1" parent="h3Dm0BbtpE6keSCLR1On-1">
