        <mxCell id="h3Dm0BbtpE6keSCLR1On-25" value="MERCADOPAGO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontFamily=Poppins;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DPoppins;fontColor=#999999;" vertex="1" parent="h3Dm0BbtpE6keSCLR1On-1">
